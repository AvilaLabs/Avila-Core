{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.avilalabs.com/core/registry-snapshot/v0.2-draft.schema.json",
  "title": "Avila Core Registry Snapshot v0.2 draft compiler subset",
  "description": "An explicit, immutable semantic registry input for the current compiler subset. It is not a live provider registry or an admission record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantic_profile",
    "registry_id",
    "revision",
    "kinds",
    "purposes",
    "roles",
    "capability_types"
  ],
  "properties": {
    "schema_version": {
      "const": "avila.core/registry-snapshot/v0.2-draft"
    },
    "semantic_profile": {
      "const": "avila.core/semantic/0.2-draft"
    },
    "registry_id": {
      "$ref": "#/$defs/nonemptyString"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "kinds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/kind"
      }
    },
    "purposes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/purpose"
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "capability_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityType"
      }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "major"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "major": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "exactNumber": {
      "type": "string",
      "description": "Canonical plain decimal or reduced rational. Reduction is enforced by the semantic kernel.",
      "pattern": "^(?:(?:0|-?[1-9][0-9]*)(?:\\.[0-9]*[1-9])?|-?[1-9][0-9]*/[1-9][0-9]*)$"
    },
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind_id",
        "canonical_unit",
        "unit_class",
        "owner",
        "units"
      ],
      "properties": {
        "kind_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "canonical_unit": {
          "$ref": "#/$defs/nonemptyString"
        },
        "unit_class": {
          "$ref": "#/$defs/nonemptyString"
        },
        "owner": {
          "$ref": "#/$defs/nonemptyString"
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/unit"
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "factor"
      ],
      "properties": {
        "symbol": {
          "$ref": "#/$defs/nonemptyString"
        },
        "factor": {
          "$ref": "#/$defs/exactNumber"
        }
      }
    },
    "purpose": {
      "type": "object",
      "description": "A nominal, governed context-of-use identity. The compiler never infers relationships between purposes from their names or descriptions.",
      "additionalProperties": false,
      "required": [
        "purpose",
        "owner",
        "description"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/versionedRef"
        },
        "owner": {
          "$ref": "#/$defs/nonemptyString"
        },
        "description": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "owner",
        "validator",
        "accepted_media_types",
        "permitted_claim_models"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/versionedRef"
        },
        "owner": {
          "$ref": "#/$defs/nonemptyString"
        },
        "validator": {
          "$ref": "#/$defs/nonemptyString"
        },
        "input_schema": {
          "description": "An embedded JSON Schema for documents that fill this role as a free input, in the restricted subset the compiler's shape validator supports. Its own keywords are checked by the registry compile pass (CORE-R3501), not by this document's shape validator.",
          "type": "object"
        },
        "quantity_kind": {
          "$ref": "#/$defs/nonemptyString"
        },
        "unit_class": {
          "$ref": "#/$defs/nonemptyString"
        },
        "accepted_media_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "permitted_claim_models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claimModel"
          }
        },
        "categorical_values": {
          "description": "Complete closed vocabulary for a non-quantity categorical role.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "non_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyString"
          },
          "default": []
        }
      }
    },
    "capabilityType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_type",
        "owner",
        "reproducibility"
      ],
      "properties": {
        "capability_type": {
          "$ref": "#/$defs/versionedRef"
        },
        "owner": {
          "$ref": "#/$defs/nonemptyString"
        },
        "reproducibility": {
          "$ref": "#/$defs/reproducibilityDeclaration"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputSlot"
          },
          "default": []
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputSlot"
          },
          "default": []
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameterDefinition"
          },
          "default": []
        },
        "review": {
          "$ref": "#/$defs/reviewDeclaration"
        },
        "non_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyString"
          },
          "default": []
        }
      }
    },
    "reviewDeclaration": {
      "type": "object",
      "description": "Type-level signature for an optional connected-agent practicality stage. Its disposition routes a candidate back to iteration or onward to the user; it cannot constitute or alter a technical requirement verdict.",
      "additionalProperties": false,
      "required": [
        "reviewer_role",
        "presented_input_slots",
        "decision_output_slot",
        "allowed_dispositions"
      ],
      "properties": {
        "reviewer_role": {
          "description": "The optional practicality stage is performed by a connected agent. Human acknowledgment, when desired, is a separate downstream concern.",
          "const": "agent"
        },
        "presented_input_slots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "decision_output_slot": {
          "$ref": "#/$defs/nonemptyString"
        },
        "allowed_dispositions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "present_to_user",
              "request_changes",
              "abstain"
            ]
          }
        }
      }
    },
    "reproducibilityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "determinism"
      ],
      "properties": {
        "determinism": {
          "enum": [
            "deterministic",
            "seeded_stochastic",
            "nondeterministic"
          ]
        },
        "material_factors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionFactorDefinition"
          },
          "default": []
        }
      }
    },
    "executionFactorDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor_id",
        "value_type"
      ],
      "properties": {
        "factor_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "value_type": {
          "$ref": "#/$defs/parameterType"
        }
      }
    },
    "parameterDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "required",
        "value_type"
      ],
      "properties": {
        "parameter_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "required": {
          "type": "boolean"
        },
        "value_type": {
          "$ref": "#/$defs/parameterType"
        }
      }
    },
    "parameterType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "min": {
              "$ref": "#/$defs/integerBound"
            },
            "max": {
              "$ref": "#/$defs/integerBound"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "exact_number"
            },
            "min": {
              "$ref": "#/$defs/exactBound"
            },
            "max": {
              "$ref": "#/$defs/exactBound"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "allowed_values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "not": {
                  "const": "not_defined"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "kind"
          ],
          "properties": {
            "type": {
              "const": "quantity"
            },
            "kind": {
              "$ref": "#/$defs/nonemptyString"
            },
            "min": {
              "$ref": "#/$defs/quantityBound"
            },
            "max": {
              "$ref": "#/$defs/quantityBound"
            }
          }
        }
      ]
    },
    "integerBound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "inclusive"
      ],
      "properties": {
        "value": {
          "type": "integer"
        },
        "inclusive": {
          "type": "boolean"
        }
      }
    },
    "exactBound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "inclusive"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/exactNumber"
        },
        "inclusive": {
          "type": "boolean"
        }
      }
    },
    "quantityValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/exactNumber"
        },
        "unit": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "quantityBound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "inclusive"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/quantityValue"
        },
        "inclusive": {
          "type": "boolean"
        }
      }
    },
    "inputSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "role",
        "accepted_media_types"
      ],
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "role": {
          "$ref": "#/$defs/versionedRef"
        },
        "accepted_media_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "outputSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "role",
        "media_type",
        "permitted_claim_models"
      ],
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "role": {
          "$ref": "#/$defs/versionedRef"
        },
        "media_type": {
          "$ref": "#/$defs/nonemptyString"
        },
        "permitted_claim_models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claimModel"
          }
        },
        "excluded_purposes": {
          "type": "array",
          "description": "Nominal governed purposes this output explicitly cannot support. Free-text non-claims are never interpreted as this field.",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/versionedRef"
          },
          "default": []
        }
      }
    },
    "claimModel": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "enum": [
                "exact",
                "coverage_interval",
                "standard_uncertainty",
                "samples",
                "distribution",
                "unquantified"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "const": "interval"
            },
            "nominal": {
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "side"
          ],
          "properties": {
            "model": {
              "const": "worst_case"
            },
            "side": {
              "enum": [
                "lower",
                "upper"
              ]
            },
            "nominal": {
              "type": "boolean",
              "default": false
            }
          }
        }
      ]
    }
  }
}
