{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.avilalabs.com/core/evidence-claims/v0.2-draft.schema.json",
  "title": "Avila Core Evidence Claims v0.2 draft",
  "description": "Claims produced by executing the steps of one compiled contract, plus attested contract inputs. Practical-review routing records are deliberately separate because they are not technical evidence and cannot alter a verdict. Admission checks the executable subset of ADR-0006 SC-11; artifact bytes, receipts, package identities, signatures, qualification, and invalidation are not checked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "semantic_profile", "compiled_snapshot_sha256"],
  "properties": {
    "schema_version": { "const": "avila.core/evidence-claims/v0.2-draft" },
    "semantic_profile": { "const": "avila.core/semantic/0.2-draft" },
    "compiled_snapshot_sha256": {
      "description": "Identity of the compiled contract these claims were produced for. A mismatch rejects the whole document (CORE-E7001).",
      "$ref": "#/$defs/sha256"
    },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/inputAttestation" }, "default": [] },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/outputClaim" }, "default": [] }
  },
  "$defs": {
    "nonemptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "exactNumber": {
      "type": "string",
      "description": "Canonical plain decimal or reduced rational.",
      "pattern": "^(?:(?:0|-?[1-9][0-9]*)(?:\\.[0-9]*[1-9])?|-?[1-9][0-9]*/[1-9][0-9]*)$"
    },
    "quantityValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": { "value": { "$ref": "#/$defs/exactNumber" }, "unit": { "$ref": "#/$defs/nonemptyString" } }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "media_type"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "media_type": { "$ref": "#/$defs/nonemptyString" } }
    },
    "inputAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "artifact"],
      "properties": { "input_id": { "$ref": "#/$defs/nonemptyString" }, "artifact": { "$ref": "#/$defs/artifactIdentity" } }
    },
    "producerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "sha256"],
      "properties": { "package_id": { "$ref": "#/$defs/nonemptyString" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "outputClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "step_id", "output_slot", "artifact", "claim"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/nonemptyString" },
        "step_id": { "$ref": "#/$defs/nonemptyString" },
        "output_slot": { "$ref": "#/$defs/nonemptyString" },
        "artifact": { "$ref": "#/$defs/artifactIdentity" },
        "producer": { "$ref": "#/$defs/producerIdentity" },
        "claim": { "$ref": "#/$defs/claimValue" },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["qualification_id", "revision", "sha256", "state", "context"],
          "description": "The producing capability's qualification envelope evaluated for this run, together with the applicability context it was evaluated over so the assessment can be re-derived independently (ADR-0018).",
          "properties": {
            "qualification_id": { "$ref": "#/$defs/nonemptyString" },
            "revision": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "state": { "enum": ["inside", "outside", "unknown"] },
            "context": { "$ref": "#/$defs/applicabilityContext" },
            "terms": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["predicate", "result"],
              "properties": { "predicate": { "type": "string" }, "result": { "enum": ["true", "false", "unknown"] } } } }
          }
        }
      }
    },
    "applicabilityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "inputs"],
      "description": "The kernel's applicability context (predicate.rs `ApplicabilityContext` as JSON): the facts the adapter extracted from the staged, digest-verified inputs, each carrying its declared source, plus each staged input's media type and SHA-256 as attributes of its slot. These are producer assertions with provenance, not universal facts.",
      "properties": {
        "params": { "type": "object", "additionalProperties": { "$ref": "#/$defs/quantityValue" } },
        "environment": { "type": "object", "additionalProperties": false, "required": ["image_digest"],
          "properties": { "image_digest": { "$ref": "#/$defs/nonemptyString" } } },
        "inputs": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false,
          "required": ["attributes"], "properties": { "attributes": { "type": "object" } } } },
        "facts": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false,
          "required": ["value", "source"],
          "properties": {
            "value": { "description": "A FactValue: a quantity {value, unit}, string, boolean, or integer.", "type": ["object", "string", "boolean", "integer"] },
            "source": { "type": "object", "additionalProperties": false, "required": ["class", "identity", "validator", "receipt"],
              "properties": {
                "class": { "$ref": "#/$defs/nonemptyString" },
                "identity": { "$ref": "#/$defs/nonemptyString" },
                "validator": { "$ref": "#/$defs/nonemptyString" },
                "receipt": { "$ref": "#/$defs/nonemptyString" } } }
          } } }
      }
    },
    "claimValue": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["model", "nominal"],
          "properties": { "model": { "const": "exact" }, "nominal": { "$ref": "#/$defs/quantityValue" } } },
        { "type": "object", "additionalProperties": false, "required": ["model", "lower", "upper"],
          "properties": { "model": { "const": "interval" }, "lower": { "$ref": "#/$defs/quantityValue" }, "upper": { "$ref": "#/$defs/quantityValue" }, "nominal": { "$ref": "#/$defs/quantityValue" } } },
        { "type": "object", "additionalProperties": false, "required": ["model", "lower", "upper", "nominal", "coverage"],
          "properties": { "model": { "const": "coverage_interval" }, "lower": { "$ref": "#/$defs/quantityValue" }, "upper": { "$ref": "#/$defs/quantityValue" }, "nominal": { "$ref": "#/$defs/quantityValue" }, "coverage": { "$ref": "#/$defs/exactNumber" } } },
        { "type": "object", "additionalProperties": false, "required": ["model"],
          "properties": { "model": { "const": "worst_case" }, "lower": { "$ref": "#/$defs/quantityValue" }, "upper": { "$ref": "#/$defs/quantityValue" }, "nominal": { "$ref": "#/$defs/quantityValue" } } },
        { "type": "object", "additionalProperties": false, "required": ["model"],
          "properties": { "model": { "const": "unquantified" }, "value": { "$ref": "#/$defs/nonemptyString", "description": "Optional categorical evidence for a non-quantity role. It is never coerced into a number and may feed a closed-vocabulary categorical requirement." }, "nominal": { "$ref": "#/$defs/quantityValue" } } }
      ]
    }
  }
}
