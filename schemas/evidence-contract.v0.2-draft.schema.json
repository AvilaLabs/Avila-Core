{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.avilalabs.com/core/evidence-contract/v0.2-draft.schema.json",
  "title": "Avila Core Evidence Contract v0.2 draft compiler subset",
  "description": "The currently executable contract subset accepted by avila-core-compiler. Scientific sufficiency, qualification, admission, and verdict semantics remain incomplete.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantic_profile",
    "contract_id",
    "revision",
    "status",
    "question",
    "workflow",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "avila.core/evidence-contract/v0.2-draft"
    },
    "semantic_profile": {
      "const": "avila.core/semantic/0.2-draft"
    },
    "contract_id": {
      "$ref": "#/$defs/nonemptyString"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "retired"
      ]
    },
    "question": {
      "description": "The bounded question the contract exists to resolve. Prose the compiler carries into the compiled boundary and never interprets.",
      "$ref": "#/$defs/nonemptyString"
    },
    "assumptions": {
      "description": "Conditions accepted without being established by the campaign. Prose, never interpreted; typed facts with provenance are a separate record.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "default": []
    },
    "execution_policy": {
      "$ref": "#/$defs/executionPolicy"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contractInput"
      },
      "default": []
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/workflowStep"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "major"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "major": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contractInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "role",
        "media_type",
        "claim_model"
      ],
      "properties": {
        "input_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "role": {
          "$ref": "#/$defs/versionedRef"
        },
        "media_type": {
          "$ref": "#/$defs/nonemptyString"
        },
        "claim_model": {
          "$ref": "#/$defs/claimModel"
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "capability_type"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "capability_type": {
          "$ref": "#/$defs/versionedRef"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "default": []
        },
        "parameters": {
          "type": "object",
          "description": "Values are checked against the capability type's declared parameter types and domains. Exact numbers are strings; quantities are objects with exact string `value` and `unit`. The exact string `not_defined` is reserved as an incomplete draft marker and never compiles into IR.",
          "additionalProperties": true,
          "default": {}
        },
        "reproducibility": {
          "$ref": "#/$defs/reproducibilityBinding"
        },
        "review": {
          "$ref": "#/$defs/reviewPolicyBinding"
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permitted_nondeterministic_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/versionedRef"
          },
          "default": []
        },
        "permit_nominal_basis": {
          "description": "Permits requirements whose basis is `nominal`. The weakening must be explicit; its absence is CORE-A4201.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "reproducibilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "$ref": "#/$defs/nonemptyString"
        },
        "material_factors": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      }
    },
    "reviewPolicyBinding": {
      "type": "object",
      "description": "Contract binding for an optional connected-agent practicality stage after technical evaluation. When included, it can return a candidate or route it to the user; it never participates in compilation success, qualification, evidence admission, or a technical verdict.",
      "additionalProperties": false,
      "required": [
        "reviewer_eligibility_policy",
        "independence"
      ],
      "properties": {
        "reviewer_eligibility_policy": {
          "$ref": "#/$defs/immutablePolicyRef"
        },
        "independence": {
          "$ref": "#/$defs/reviewIndependence"
        },
        "instructions": {
          "description": "Exact practical instructions bound into the optional agent stage. At least one is required; the compiler does not interpret whether the connected agent followed them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyString"
          },
          "default": []
        }
      }
    },
    "immutablePolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "revision",
        "sha256"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewIndependence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "requirements"
          ],
          "properties": {
            "mode": {
              "const": "constraints"
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/independenceRequirement"
              }
            }
          }
        }
      ]
    },
    "independenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "separated_from",
        "minimum_separation"
      ],
      "properties": {
        "separated_from": {
          "enum": [
            "requester",
            "method_owner",
            "capability_provider",
            "executor"
          ]
        },
        "minimum_separation": {
          "enum": [
            "different_person",
            "different_organization"
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_slot",
        "source"
      ],
      "properties": {
        "input_slot": {
          "$ref": "#/$defs/nonemptyString"
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        }
      }
    },
    "sourceRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "input_id"
          ],
          "properties": {
            "source": {
              "const": "contract_input"
            },
            "input_id": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "step_id",
            "output_slot"
          ],
          "properties": {
            "source": {
              "const": "step_output"
            },
            "step_id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "output_slot": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "statement",
        "purpose",
        "comparison",
        "limit",
        "basis"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "statement": {
          "$ref": "#/$defs/nonemptyString"
        },
        "purpose": {
          "$ref": "#/$defs/versionedRef"
        },
        "metric": {
          "$ref": "#/$defs/sourceRef"
        },
        "comparison": {
          "enum": [
            "less_than",
            "less_than_or_equal",
            "greater_than",
            "greater_than_or_equal",
            "equal"
          ]
        },
        "limit": {
          "$ref": "#/$defs/typedQuantity"
        },
        "tolerance": {
          "description": "Required by, and only meaningful for, an `equal` comparison: a nonnegative quantity of the metric kind. Its absence on `equal`, or presence on any other comparison, is CORE-T2104.",
          "$ref": "#/$defs/typedQuantity"
        },
        "basis": {
          "$ref": "#/$defs/requirementBasis"
        }
      }
    },
    "typedQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/nonemptyString"
        },
        "value": {
          "$ref": "#/$defs/exactNumber"
        },
        "unit": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "exactNumber": {
      "type": "string",
      "description": "Canonical plain decimal or reduced rational. Reduction is enforced by the semantic kernel, not this regular expression.",
      "pattern": "^(?:(?:0|-?[1-9][0-9]*)(?:\\.[0-9]*[1-9])?|-?[1-9][0-9]*/[1-9][0-9]*)$"
    },
    "requirementBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "bounded",
            "enclosure",
            "nominal"
          ]
        },
        "coverage": {
          "description": "Canonical decimal in (0, 1]; only meaningful when `kind` is `bounded`.",
          "$ref": "#/$defs/exactNumber"
        }
      }
    },
    "claimModel": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "enum": [
                "exact",
                "coverage_interval",
                "standard_uncertainty",
                "samples",
                "distribution",
                "unquantified"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "const": "interval"
            },
            "nominal": {
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "side"
          ],
          "properties": {
            "model": {
              "const": "worst_case"
            },
            "side": {
              "enum": [
                "lower",
                "upper"
              ]
            },
            "nominal": {
              "type": "boolean",
              "default": false
            }
          }
        }
      ]
    }
  }
}
