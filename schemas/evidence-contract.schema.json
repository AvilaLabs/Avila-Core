{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.avilalabs.com/core/evidence-contract/v0.1.schema.json",
  "title": "Avila Core Evidence Contract v0.1",
  "description": "A bounded technical question, its required capability graph, and the policy governing admissible evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "title",
    "question",
    "status",
    "workflow",
    "requirements",
    "evidence_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "avila.core/evidence-contract/v0.1"
    },
    "contract_id": {
      "$ref": "#/$defs/nonemptyString"
    },
    "title": {
      "$ref": "#/$defs/nonemptyString"
    },
    "question": {
      "$ref": "#/$defs/nonemptyString"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "retired"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputReference"
      },
      "default": []
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capabilityRequest"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "evidence_policy": {
      "$ref": "#/$defs/evidencePolicy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "inputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "role",
        "uri",
        "media_type"
      ],
      "properties": {
        "input_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "role": {
          "$ref": "#/$defs/nonemptyString"
        },
        "uri": {
          "$ref": "#/$defs/nonemptyString"
        },
        "media_type": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "capability_type"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "capability_type": {
          "$ref": "#/$defs/nonemptyString"
        },
        "implementation": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "parameters": {
          "default": null
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "statement",
        "metric",
        "comparison",
        "limit",
        "unit"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "statement": {
          "$ref": "#/$defs/nonemptyString"
        },
        "metric": {
          "$ref": "#/$defs/nonemptyString"
        },
        "comparison": {
          "enum": [
            "less_than",
            "less_than_or_equal",
            "greater_than",
            "greater_than_or_equal",
            "equal"
          ]
        },
        "limit": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/nonemptyString"
        },
        "evaluation_step": {
          "type": "string"
        }
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_unqualified_capabilities": {
          "type": "boolean",
          "default": false
        },
        "require_complete_lineage": {
          "type": "boolean",
          "default": true
        },
        "require_content_hashes": {
          "type": "boolean",
          "default": true
        },
        "required_review_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    }
  }
}

